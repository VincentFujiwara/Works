#include <stdio.h>

int main() {
	
	int today;
	
	printf("set number of day (1 - 7): ");
	if (scanf("%d", &today) != 1) {
		printf("input error!\n");
		return 1;
	}
	
	if (today == 1) {
		printf("Monday\n");
	} else if (today == 2) {
		printf("Tuesday\n");
	} else if (today == 3) {
		printf("Wednesday\n");
	} else if (today == 4) {
		printf("Thursday\n");
	} else if (today == 5) {
		printf("Friday\n");
	} else if (today == 6) {
		printf("Saturday\n");
	} else if (today == 7) {
		printf("Sunday\n");
	} else {
		printf("incorrect number of day!\n");
	}
	
	return 0;
}
