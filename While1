// Задачник Абрамяна - задача While1
//
// Даны положительные числа A и B (A > B). На отрезке длины A
// размещено максимально возможное количество отрезков длины B (безналожений).
// Не используя операции умножения и деления, найти длину незанятой части отрезка A.
// 
// Решение Урсу Артёма

#include <stdio.h>
int main (){
	int a,b;
	scanf ("%d %d",&a,&b);
	
	//     a      >    b
	// <----------\--------->
	
	while (a>b){
	a=a-b;
	}
	printf ("%d",a);
	return 0;
}
