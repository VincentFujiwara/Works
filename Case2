// Задачник Абрамяна - задача case2
//
//Дано целое число K. Вывести строку-описание оценки,соответствующей числу K 
//(1 — «плохо», 2 — «неудовлетворительно», 3 — «удовлетворительно», 4 — «хорошо», 5 — «отлично»).
//Если K не лежит в диапазоне 1–5,то вывести строку «ошибка».
//
// Решение Урсу Артёма

#include <stdio.h>

int main() {
	
	int K;
	
	printf("set student mark (2 - 5):\n ");
	
	if (scanf("%d", &K) != 1) {
		printf("input error!\n");
		return 1;
	}

	else if (K == 2) {	
		printf("bad\n");
	}	
		
	else if (K == 3) {
		printf("nice\n");
	}
		
	else if (K == 4) {
		printf("good\n");
	}
		
	else if (K == 5) {
		printf("very nice!\n");
	}
		
	else {
		printf("incorrect mark input!\n");
	}
	
	
	return 0;
}
